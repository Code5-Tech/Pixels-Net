<UserControl x:Class="Pixels.TestApp.Components.NumbericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pixels.TestApp.Components"
             mc:Ignorable="d" >
	<StackPanel Orientation="Horizontal">
		<TextBox Width="40" Name="tbxNumber" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" GotFocus="tbxNumber_GotFocus"
				 IsEnabled="True" FontWeight="SemiBold" FontSize="12" TextChanged="tbxNumber_TextChanged" KeyUp="tbxNumber_KeyUp"></TextBox>
		<Slider Width="90" Value="0" Minimum="0" Maximum="255" VerticalAlignment="Center" Margin="5" Name="sldrValue" ValueChanged="sldrValue_ValueChanged">
			
		</Slider>
    </StackPanel>
</UserControl>
